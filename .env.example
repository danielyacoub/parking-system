# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/hk_parking

# MQTT broker used by the server-side listener
MQTT_URL=mqtt://127.0.0.1:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CLIENT_ID=hk-parking-server

# Custom Next.js + Socket.io server
PORT=3000
# Shared secret used by Next.js route handlers to reach the internal
# Socket.io broadcast bridge. Change this outside local development.
INTERNAL_BROADCAST_SECRET=change-me-in-production
# SOCKET_CORS_ORIGIN=http://localhost:3000

# Admin console credentials (change these before deploying)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
